NODE_ENV=production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smart_medicine_db
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
API_RESPONSE_ENCRYPTION_ENABLED=true
API_RESPONSE_ENCRYPTION_KEY=replace-with-a-very-long-random-32-byte-or-more-key
VITE_API_RESPONSE_ENCRYPTION_KEY=replace-with-the-same-key-as-API_RESPONSE_ENCRYPTION_KEY
# Leave empty when the frontend and API are deployed in the same Vercel project.
VITE_API_URL=
